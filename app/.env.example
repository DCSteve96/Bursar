NEAR_NETWORK=testnet
BURSAR_TREASURY=treasury.you.testnet
BURSAR_AGENT=agent.you.testnet
BURSAR_EXECUTOR=executor.you.testnet
BURSAR_RELAYER=executor.you.testnet
BURSAR_RELAYER_URL=http://127.0.0.1:8787
BURSAR_USDC=tusdc.you.testnet
BURSAR_OWNER=you.testnet
# NEAR AI Cloud (https://cloud.near.ai): leave empty to use the offline parser for the sample invoices
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Approvals from Telegram: the relay that hosts the inbox and this treasury's inbox token (console, Settings, Keys).
# Both set, the agent also reads and submits what the owner approves from Telegram.
BURSAR_RELAY=
BURSAR_INBOX_TOKEN=
# NEAR Intents partner JWT (optional, lowers fees). Mainnet only.
ONE_CLICK_JWT=
